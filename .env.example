# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# ── Dữ liệu & model ──────────────────────────────────────────────────────────
VNSTOCK_API_KEY=
AMIBROKER_HIST_DIR=C:\AmibrokerData\history_by_ticker
AMIBROKER_SCAN_CSV=C:\AmibrokerData\scan_result.csv
LSTM_MODEL_PATH=C:\AmibrokerData\stock_lstm_v7.keras
LSTM_SCALER_PATH=C:\AmibrokerData\stock_scaler_v7.pkl

# ── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Cảnh báo Telegram ────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_BUY_THRESHOLD=65
ALERT_SELL_THRESHOLD=35
ALERT_COOLDOWN_DAYS=3

# ── Email báo cáo lãi/lỗ cuối ngày (tab Phái Sinh) ───────────────────────────
# Gmail: BẮT BUỘC dùng App Password (Google Account > Security > 2-Step
# Verification > App passwords), KHÔNG dùng mật khẩu đăng nhập thường.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Nhiều người nhận: ngăn cách bằng dấu phẩy
REPORT_EMAIL_TO=
# Để trống thì dùng luôn SMTP_USER làm người gửi
REPORT_EMAIL_FROM=
